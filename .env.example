# Copia a .env y ajusta. Todas las variables usan el prefijo VISIONQ_.
VISIONQ_LOG_LEVEL=INFO
VISIONQ_CONFIDENCE_THRESHOLD=0.60
VISIONQ_MAX_UPLOAD_MB=5
VISIONQ_MAX_BATCH_IMAGES=16
VISIONQ_MAX_BATCH_RECORDS=1000
# Umbral de decisión de fallas; vacío = el seleccionado en entrenamiento
# VISIONQ_FAILURE_THRESHOLD=0.36
# Orígenes permitidos para CORS (separados por comas)
VISIONQ_CORS_ORIGINS=*
# Si se define, los endpoints POST exigen el header X-API-Key
# VISIONQ_API_KEY=cambia-esto
